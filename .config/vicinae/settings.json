{
   "$schema": "https://vicinae.com/schemas/config.json",
   "pop_to_root_on_close": true,
   "activate_on_single_click": true,
   "tray": {
      "enabled": false
   },
   "font": {
      "rendering": "native",
      "normal": {
         "family": "Lilex",
         "size": 12
      }
   },
   "theme": {
      "dark": {
         "name": "vicinae-dark"
      }
   },
   "launcher_window": {
      "opacity": 1,
      "client_side_decorations": {
         "enabled": true,
         "border_width": 1
      },
      "compact_mode": {
         "enabled": false
      },
      "floating_status_bar": true
   },
   "favorites": [],
   "providers": {
      "@Keyruu/store.raycast.zen-browser": {
         "preferences": {
            "aiSearchHistoryLimitResults": "50",
            "limitResults": "50",
            "newTabShortcut": "command t",
            "profileDirectorySuffix": "Default (release)",
            "profilesDirectory": "/home/ashenafi/.var/app/app.zen_browser.zen/.zen/1cowbaqo.Default (release)",
            "searchEngine": "Default"
         },
         "entrypoints": {
            "new-private-window": {
               "enabled": false
            },
            "new-tab": {
               "enabled": false
            },
            "new-window": {
               "enabled": false
            },
            "open-workspace": {
               "enabled": false
            },
            "search-bookmarks": {
               "alias": "b"
            },
            "search-history": {
               "enabled": false
            }
         }
      },
      "applications": {
         "entrypoints": {
            "GitButler": {
               "alias": "gb"
            },
            "code": {
               "alias": "vs"
            },
            "com.microsoft.VSCode": {
               "alias": "vs code"
            },
            "io.gitlab.news_flash.NewsFlash": {
               "alias": "nf"
            },
            "org.gnome.TextEditor": {
               "alias": "te"
            },
            "telegram-desktop_telegram-desktop": {
               "alias": "tg"
            },
            "todoist": {
               "alias": "td",
               "enabled": true
            }
         }
      },
      "clipboard": {
         "preferences": {
            "eraseOnStartup": false,
            "evictionThreshold": "2592000",
            "ignorePasswords": true,
            "monitoring": true,
            "preserveTagged": true
         },
         "entrypoints": {
            "history": {
               "preferences": {
                  "defaultAction": "paste"
               }
            }
         }
      },
      "core": {
         "entrypoints": {
            "about": {
               "enabled": true
            },
            "report-bug": {
               "enabled": false
            },
            "search-builtin-icons": {
               "enabled": true
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "manage-shortcuts": {
         "enabled": false
      },
      "power": {
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "sleep": {
               "enabled": false
            },
            "soft-reboot": {
               "enabled": false
            }
         }
      },
      "raycast-compat": {
         "entrypoints": {
            "store": {
               "preferences": {
                  "alwaysShowIntro": false
               }
            }
         }
      },
      "scripts": {
         "enabled": false
      },
      "shortcuts": {
         "enabled": false
      },
      "system": {
         "enabled": true,
         "entrypoints": {
            "browse-apps": {
               "enabled": true
            },
            "run": {
               "enabled": true
            },
            "set-default-terminal": {
               "enabled": true
            }
         }
      },
      "theme": {
         "enabled": false
      },
      "wm": {
         "enabled": false
      }
   }
}